      "exclusiveMaximum": 180
    },
    "altitude_km": {
      "type": "number",
      "minimum": 0
    },
    "histogram_kind": {
      "enum": [
        "observed_counts",
        "expected_counts"
      ]
    },
    "histogram": {
      "type": "array",

      "type": "string",
      "format": "date-time",
      "description": "Acquisition interval start in UTC, ISO 8601 with trailing Z",
      "pattern": "Z$"
    },
    "latitude_deg": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude_deg": {
